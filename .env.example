# Copy to .env (git-ignored). Never commit real values.

PORT=8787
# Where matches, players and the generated testnet key live. Mount a volume here in production.
DATA_DIR=

# AI (Pip). Server-side only. Without a key Pip falls back to a built-in question bank.
GEMINI_API_KEY=
GEMINI_MODEL=

# Chain adapter.
#   CHAIN=mock                       no network, in-memory, for tests (default)
#   CHAIN=nimiq NETWORK=testnet      Nimiq testnet over JSON-RPC (key auto-generated into DATA_DIR)
#   CHAIN=nimiq NETWORK=mainnet      real NIM. Also needs ALLOW_MAINNET=yes and an existing escrow key.
CHAIN=mock
NETWORK=testnet
ALLOW_MAINNET=

# Escrow wallet key (64 hex). Prefer ESCROW_KEY_FILE (chmod 600) or a platform secret.
# Mainnet never auto-generates a key: run `npm run wallet:mainnet` once, it prints only the public address.
ESCROW_PRIVATE_KEY=
ESCROW_KEY_FILE=

# Safety: largest stake in NIM a player can choose (default 25 on mainnet, 1000 elsewhere)
MAX_STAKE_NIM=
# Confirmations before a deposit counts (default 2)
MIN_CONFIRMATIONS=2
# Optional JSON-RPC override (the public nimiqwatch endpoints are rate limited)
NIMIQ_RPC_URL=

# Jar lock length in days (0 = unlock immediately, useful for demos)
JAR_LOCK_DAYS=30
