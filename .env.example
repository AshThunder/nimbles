# Copy to .env (git-ignored). Never commit real values.

PORT=8787

# AI (Pip). Server-side only. Without a key Pip falls back to a built-in question bank.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Chain adapter: "mock" (default, no network, for tests) or "testnet" (Nimiq TestAlbatross).
# Nimbles refuses to start with CHAIN=mainnet unless ALLOW_MAINNET=yes is also set.
CHAIN=mock

# Escrow / payout wallet for testnet. Leave empty and the server generates a testnet-only key
# into data/escrow.key (git-ignored). You can also supply your own 64-hex private key.
ESCROW_PRIVATE_KEY=

# Jar lock length in days (0 = unlock immediately, useful for demos)
JAR_LOCK_DAYS=30
